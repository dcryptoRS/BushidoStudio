// The video scopes (Royalty Studio fork): the monitor's frame measured - a
// waveform of its luma, the RGB parade, the vectorscope with its colour
// targets and the skin-tone line, and the histogram - one at a time or all
// four. The traces are drawn on the GPU from the frame the monitor shows
// (concat_render::scopes) and arrive here as pictures; the graticules are
// drawn here, over them, in the window's own type.
//
// Read on a near-black ground whatever the theme, as every grading suite
// draws its scopes: a trace is light, and the eye judges it against black.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Pane, PaneHeader } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Editor } from "../editor.slint";

/// The ground every scope is read on.
global Scope {
    out property <color> ground: #0b0b0d;
    out property <color> line: #ffffff1f;
    out property <color> line-strong: #ffffff40;
    out property <color> label: #ffffff8c;
}

// Levels from 0 to 100 IRE every ten, labelled every twenty, for the
// waveform and the parade; the parade split into its three channels.
component LevelScope inherits Rectangle {
    in property <image> source;
    /// 3 for the parade: its channels, told apart by a rule and a letter.
    in property <int> channels: 1;
    /// The labels down the side; off in the four-up view, where the room
    /// is the trace's.
    in property <bool> labelled: true;

    property <length> gutter: root.labelled ? 26px : 0px;

    background: Scope.ground;
    clip: true;

    trace := Rectangle {
        x: root.gutter;
        y: 6px;
        width: root.width - root.gutter - 6px;
        height: root.height - 12px;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: fill;
        }

        for step in 11: Rectangle {
            x: 0;
            y: parent.height * (1 - step / 10) - 0.5px;
            width: parent.width;
            height: 1px;
            background: (step == 0 || step == 10) ? Scope.line-strong : Scope.line;
        }

        for channel in root.channels - 1: Rectangle {
            x: parent.width * (channel + 1) / root.channels;
            y: 0;
            width: 1px;
            height: parent.height;
            background: Scope.line-strong;
        }

        if root.channels == 3: Text {
            x: 4px;
            y: 2px;
            text: "R";
            color: #ff6b63;
            font-size: Theme.fs-xs;
            font-weight: 600;
        }
        if root.channels == 3: Text {
            x: parent.width / 3 + 4px;
            y: 2px;
            text: "G";
            color: #5fe373;
            font-size: Theme.fs-xs;
            font-weight: 600;
        }
        if root.channels == 3: Text {
            x: parent.width * 2 / 3 + 4px;
            y: 2px;
            text: "B";
            color: #6d9dff;
            font-size: Theme.fs-xs;
            font-weight: 600;
        }
    }

    if root.labelled: Rectangle {
        x: 0;
        y: trace.y;
        width: root.gutter;
        height: trace.height;

        for step in 6: Text {
            x: 0;
            y: parent.height * (1 - step / 5) - self.height / 2;
            width: parent.width - 4px;
            text: "\{step * 20}";
            color: Scope.label;
            font-family: Theme.font-technical;
            font-size: Theme.fs-xs;
            horizontal-alignment: right;
        }
    }
}

// One of the six 75% targets, a small box where a bar of that colour lands.
component Target inherits Rectangle {
    in property <float> u;
    in property <float> v;
    in property <string> name;
    in property <length> side;
    in property <color> tint;

    x: root.u * root.side - 5px;
    y: root.v * root.side - 5px;
    width: 10px;
    height: 10px;
    border-width: 1px;
    border-color: root.tint;
    border-radius: 2px;

    Text {
        x: root.u < 0.5 ? -self.preferred-width - 3px : 13px;
        y: (parent.height - self.preferred-height) / 2;
        text: root.name;
        color: root.tint;
        font-size: Theme.fs-xs;
    }
}

// Cb across and Cr up, grey in the middle: the circle a full saturation
// reaches, the six targets of 75% bars, and the skin-tone line, along which
// faces of every complexion fall.
component VectorScope inherits Rectangle {
    in property <image> source;
    in property <bool> labelled: true;

    background: Scope.ground;
    clip: true;

    property <length> side: Math.min(root.width, root.height) - 12px;

    disc := Rectangle {
        x: (root.width - root.side) / 2;
        y: (root.height - root.side) / 2;
        width: root.side;
        height: root.side;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: fill;
        }

        // The cross, and the circle a fully saturated primary reaches.
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1;
            viewbox-height: 1;
            stroke: Scope.line;
            stroke-width: 1px;
            commands: "M 0.5 0.02 L 0.5 0.98 M 0.02 0.5 L 0.98 0.5 M 0.962 0.5 A 0.462 0.462 0 1 0 0.038 0.5 A 0.462 0.462 0 1 0 0.962 0.5 M 0.731 0.5 A 0.231 0.231 0 1 0 0.269 0.5 A 0.231 0.231 0 1 0 0.731 0.5";
        }

        // The skin-tone line, at 123° from Cb: between red and yellow.
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1;
            viewbox-height: 1;
            stroke: #ffc98a99;
            stroke-width: 1px;
            commands: "M 0.5 0.5 L 0.244 0.1058";
        }

        if root.labelled: Target { side: root.side; u: 0.4227; v: 0.1625; name: "R"; tint: #ff6b63; }
        if root.labelled: Target { side: root.side; u: 0.7602; v: 0.1934; name: "Mg"; tint: #ef7bf0; }
        if root.labelled: Target { side: root.side; u: 0.8375; v: 0.5309; name: "B"; tint: #6d9dff; }
        if root.labelled: Target { side: root.side; u: 0.5773; v: 0.8375; name: "Cy"; tint: #63e6f0; }
        if root.labelled: Target { side: root.side; u: 0.2398; v: 0.8066; name: "G"; tint: #5fe373; }
        if root.labelled: Target { side: root.side; u: 0.1625; v: 0.4691; name: "Yl"; tint: #f3e36b; }
    }
}

// Levels across, black on the left: red, green and blue laid over each
// other and luma as a white edge, with the quarters marked.
component HistogramScope inherits Rectangle {
    in property <image> source;
    in property <bool> labelled: true;

    background: Scope.ground;
    clip: true;

    plot := Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.height - (root.labelled ? 24px : 12px);

        Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: fill;
        }

        for quarter in 5: Rectangle {
            x: parent.width * quarter / 4 - 0.5px;
            y: 0;
            width: 1px;
            height: parent.height;
            background: (quarter == 0 || quarter == 4) ? Scope.line-strong : Scope.line;
        }
    }

    if root.labelled: Text {
        x: plot.x;
        y: plot.y + plot.height + 2px;
        text: "0";
        color: Scope.label;
        font-family: Theme.font-technical;
        font-size: Theme.fs-xs;
    }
    if root.labelled: Text {
        x: plot.x + plot.width - self.preferred-width;
        y: plot.y + plot.height + 2px;
        text: "100";
        color: Scope.label;
        font-family: Theme.font-technical;
        font-size: Theme.fs-xs;
    }
}

export component ScopesPane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    VerticalLayout {
        PaneHeader {
            title: I18n.t("scopes.title");

            VerticalLayout {
                alignment: center;
                PaneSwitcher {
                    kind: PaneKind.scopes;
                    seat: root.pane-seat;
                    removable: root.pane-removable;
                    picked(kind) => { root.pane-picked(kind); }
                    removed => { root.pane-removed(); }
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 8px;

            SegmentedControl {
                options: [
                    I18n.t("scopes.waveform"), I18n.t("scopes.parade"),
                    I18n.t("scopes.vectorscope"), I18n.t("scopes.histogram"),
                    I18n.t("scopes.all"),
                ];
                property <int> wanted: Editor.scope-view;
                changed wanted => { self.current = self.wanted; }
                current: Editor.scope-view;
                changed(index) => { Editor.scope-view-changed(index); }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            body := Rectangle {
                x: 10px;
                y: 0;
                width: parent.width - 20px;
                height: parent.height - 10px;
                border-radius: Theme.r;
                background: Scope.ground;
                clip: true;

                if !Editor.scopes-ready: Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: I18n.t("scopes.waiting");
                    color: Scope.label;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if Editor.scopes-ready && Editor.scope-view == 0: LevelScope {
                    width: parent.width;
                    height: parent.height;
                    source: Editor.scope-waveform;
                }
                if Editor.scopes-ready && Editor.scope-view == 1: LevelScope {
                    width: parent.width;
                    height: parent.height;
                    source: Editor.scope-parade;
                    channels: 3;
                }
                if Editor.scopes-ready && Editor.scope-view == 2: VectorScope {
                    width: parent.width;
                    height: parent.height;
                    source: Editor.scope-vector;
                }
                if Editor.scopes-ready && Editor.scope-view == 3: HistogramScope {
                    width: parent.width;
                    height: parent.height;
                    source: Editor.scope-histogram;
                }

                // The four at once, as a grading suite's scope screen.
                if Editor.scopes-ready && Editor.scope-view == 4: Rectangle {
                    width: parent.width;
                    height: parent.height;

                    LevelScope {
                        x: 0;
                        y: 0;
                        width: parent.width / 2 - 1px;
                        height: parent.height / 2 - 1px;
                        source: Editor.scope-waveform;
                        labelled: parent.width > 520px;
                    }
                    VectorScope {
                        x: parent.width / 2 + 1px;
                        y: 0;
                        width: parent.width / 2 - 1px;
                        height: parent.height / 2 - 1px;
                        source: Editor.scope-vector;
                        labelled: parent.width > 520px;
                    }
                    LevelScope {
                        x: 0;
                        y: parent.height / 2 + 1px;
                        width: parent.width / 2 - 1px;
                        height: parent.height / 2 - 1px;
                        source: Editor.scope-parade;
                        channels: 3;
                        labelled: parent.width > 520px;
                    }
                    HistogramScope {
                        x: parent.width / 2 + 1px;
                        y: parent.height / 2 + 1px;
                        width: parent.width / 2 - 1px;
                        height: parent.height / 2 - 1px;
                        source: Editor.scope-histogram;
                        labelled: parent.width > 520px;
                    }
                }
            }
        }
    }
}
