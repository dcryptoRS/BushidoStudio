# Maintainer: Royalty Studio <maintainer@royalty-studio.invalid>
# Bushido Studio, a modified Concat (Royalty Studio fork). Concat's own
# package was maintained by noxygalaxy; this one is Royalty Studio's.
pkgname=bushido-studio
pkgver=${BUSHIDO_VERSION:?BUSHIDO_VERSION must be set}
pkgrel=1
pkgdesc="Video editor for reels and film, based on Concat"
arch=('x86_64' 'aarch64')
url="https://github.com/dcryptoRS/BushidoStudio"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'vulkan-icd-loader' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${BUSHIDO_STAGE:?BUSHIDO_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/bushido-studio" "$pkgdir/opt/bushido-studio/bushido-studio"
  install -d "$pkgdir/opt/bushido-studio/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/bushido-studio/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/bushido-studio/bushido-studio "$@"\n' > "$pkgdir/usr/bin/bushido-studio"
  chmod 755 "$pkgdir/usr/bin/bushido-studio"
  install -Dm644 "$stage/bushido-studio.desktop" "$pkgdir/usr/share/applications/bushido-studio.desktop"
  sed -i 's|^Exec=bushido-studio|Exec=/opt/bushido-studio/bushido-studio %U|' "$pkgdir/usr/share/applications/bushido-studio.desktop"
  install -Dm644 "$stage/bushido-studio.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/bushido-studio.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/bushido-studio/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/bushido-studio/THIRD_PARTY_NOTICES.md"
}
